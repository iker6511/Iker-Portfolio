---
// ============================================================================
// posts/index.astro — LISTADO DE WRITE-UPS
// ============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const count = `${sortedPosts.length} ${sortedPosts.length === 1 ? 'write-up' : 'write-ups'}`;
---

<BaseLayout
  title="Write-ups de DFIR — Iker"
  description="Retos de análisis forense digital resueltos y documentados: metodología, evidencia, IOCs y línea de tiempo."
>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">Análisis forense digital · {count}</span>
      <h1>Write-ups de DFIR</h1>
      <p class="page-intro">
        Retos de plataformas como CyberDefenders y LetsDefend, resueltos y documentados de principio
        a fin: metodología, evidencia, IOCs y línea de tiempo. Incluyo también qué me costó y qué
        haría distinto, porque de eso se aprende más que del resultado.
      </p>
    </header>

    {sortedPosts.length === 0 ? (
      <div class="empty">
        <span class="empty-prompt">C:\WRITEUPS&gt; dir<span class="cursor" aria-hidden="true"></span></span>
        <p>Aún no hay write-ups publicados.</p>
      </div>
    ) : (
      <div class="card post-list">
        {sortedPosts.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .post-list {
    overflow: hidden;
  }
</style>
