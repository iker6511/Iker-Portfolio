---
// ============================================================================
// posts/[...slug].astro — WRITE-UP INDIVIDUAL
// ============================================================================
// Columna de lectura cómoda (~72 caracteres) con fecha, título, resumen y
// etiquetas, y el contenido del Markdown.
// ============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;

const { Content } = await render(post);

const fmt = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const formattedDate = fmt(post.data.pubDate);
const formattedUpdated = post.data.updatedDate ? fmt(post.data.updatedDate) : undefined;
---

<BaseLayout title={`${post.data.title} — Iker`} description={post.data.description}>
  <div class="container container-narrow">
    <header class="page-head post-head">
      <a href={`${base}posts/`} class="key back-link"><Icon name="arrow-left" size={14} /> Write-ups</a>

      <span class="eyebrow">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        {formattedUpdated && <> · actualizado {formattedUpdated}</>}
      </span>

      <h1>{post.data.title}</h1>
      <p class="page-intro">{post.data.description}</p>

      {post.data.tags.length > 0 && (
        <ul class="chips post-tags">
          {post.data.tags.map((tag) => <li class="key key-sm">#{tag}</li>)}
        </ul>
      )}
    </header>

    <article class="prose">
      <Content />
    </article>

    <nav class="post-end">
      <a href={`${base}posts/`} class="btn"><Icon name="arrow-left" size={16} /> Todos los write-ups</a>
      <a href="mailto:iker.reyesn8@gmail.com" class="btn btn-primary">Comentarlo conmigo <Icon name="mail" size={16} /></a>
    </nav>
  </div>

  <Lightbox />
</BaseLayout>

<style>
  .post-head {
    border-bottom: 2px dashed var(--line);
    margin-bottom: 2.2rem;
  }

  .post-tags {
    margin-top: 1.2rem;
  }

  .post-end {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 2px dashed var(--line);
  }
</style>
