---
// ============================================================================
// index.astro — PÁGINA PRINCIPAL
// ============================================================================
// Secciones (cada una marcada con una tecla de función, como la fila F1–F12
// del Model M):
//   Hero         → presentación, foto en un monitor de la época, habilidades
//   F1 Sobre mí
//   F2 Experiencia
//   F3 Proyectos (destacados)
//   F4 Write-ups (últimos)
//   F5 Certificaciones   → edita el array `certificaciones`
//   Contacto     → botón con forma de tecla Intro
// ============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Últimos 3 write-ups publicados
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Proyectos destacados
const allProjects = await getCollection('proyectos');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.order - a.data.order);

// 👇 HABILIDADES (aparecen como teclas en la presentación) 👇
const skills = ['PHP', 'Linux', 'WordPress', 'Dolibarr', 'Bash', 'Volatility3', 'Autopsy', 'FTK Imager'];

// 👇 CERTIFICACIONES: añade aquí las tuyas 👇
//   { title: 'Nombre', issuer: 'Entidad', year: 2026, url: 'https://...' (opcional) }
const certificaciones: { title: string; issuer: string; year: number; url?: string }[] = [];
---

<BaseLayout
  title="Iker Reyes — Proyectos de sistemas y DFIR"
  description="Proyectos de desarrollo, administración de sistemas y análisis forense digital, junto con write-ups y respuesta a incidentes."
>
  <!-- =============================================================
       HERO
       ============================================================= -->
  <section class="hero container">
    <div class="hero-text rise">
      <span class="eyebrow">Hola, soy Iker<span class="cursor" aria-hidden="true"></span></span>
      <h1>
        Desarrollo, administro y <span class="hero-accent">analizo</span> sistemas.
      </h1>
      <p class="hero-tagline">
        Desarrollador PHP y Sysadmin con 3 años de experiencia, orientando el perfil hacia
        análisis forense digital y respuesta a incidentes.
      </p>

      <div class="hero-actions">
        <a href={`${base}proyectos/`} class="btn btn-primary">
          Ver proyectos <Icon name="arrow-right" size={16} />
        </a>
        <a href={`${base}posts/`} class="btn">Leer write-ups</a>
      </div>

      <ul class="chips hero-skills" aria-label="Herramientas y tecnologías">
        {skills.map((s) => <li class="key">{s}</li>)}
      </ul>
    </div>

    <!-- Foto dentro de un monitor beige de los 80 -->
    <figure class="monitor rise" aria-hidden="true">
      <div class="monitor-bezel">
        <div class="monitor-screen">
          <img class="pic-day" src={`${base}images/iker-retro-day.png`} alt="" width="320" height="320" />
          <img class="pic-night" src={`${base}images/iker-retro-night.png`} alt="" width="320" height="320" />
        </div>
        <div class="monitor-chin">
          <span class="monitor-label mono">IKER · 5151</span>
          <span class="monitor-power"></span>
        </div>
      </div>
      <div class="monitor-stand"></div>
    </figure>
  </section>

  <!-- =============================================================
       F1 — SOBRE MÍ
       ============================================================= -->
  <section id="sobre-mi" class="section container">
    <div class="section-head">
      <h2 class="section-title"><span class="key key-mod">F1</span> Sobre mí</h2>
    </div>

    <div class="about">
      <div class="prose">
        <p>
          Trabajo como desarrollador PHP, principalmente con WordPress y Dolibarr, donde
          principalmente realizo adaptaciones sobre sistemas existentes, resolución de
          incidencias, análisis de problemas y mantenimiento de aplicaciones en producción.
        </p>
        <p>
          Esa parte de sistemas es la que me llevó al análisis forense. Cuando administras una
          máquina acabas queriendo saber exactamente qué le ha pasado, en qué orden y con qué
          rastro. Ahí es donde estoy poniendo el foco: análisis de memoria, forense de disco,
          análisis de tráfico y respuesta a incidentes.
        </p>
        <p>
          Formado en informática forense y elaboración de informes periciales. Publico write-ups
          de los retos que resuelvo porque documentar es la única forma de aprender de verdad, y
          porque un informe bien escrito es la mitad del trabajo.
        </p>
      </div>

      <aside class="card facts">
        <span class="eyebrow">En corto</span>
        <dl>
          <div><dt>Rol</dt><dd>Desarrollador PHP / Sysadmin</dd></div>
          <div><dt>Experiencia</dt><dd>3 años</dd></div>
          <div><dt>Enfoque</dt><dd>DFIR y blue team</dd></div>
          <div><dt>Formación</dt><dd>Perito informático forense, DAW, ASIR</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- =============================================================
       F2 — EXPERIENCIA
       ============================================================= -->
  <section id="experiencia" class="section container">
    <div class="section-head">
      <h2 class="section-title"><span class="key key-mod">F2</span> Experiencia y formación</h2>
    </div>

    <ol class="timeline">
      <li class="tl-item">
        <span class="tl-date mono"><span class="tl-led tl-led-on" aria-hidden="true"></span>Presente</span>
        <div class="tl-body">
          <h3>Formación autodidacta en DFIR y blue team</h3>
          <span class="tl-sub">En paralelo al trabajo</span>
          <p>
            Proyectos de análisis forense: memoria con Volatility3, análisis de disco con Autopsy
            y Timeline Explorer, tráfico de red y reglas de detección Sigma. Documento los
            hallazgos y aprendizajes de cada proyecto y reto.
          </p>
        </div>
      </li>

      <li class="tl-item">
        <span class="tl-date mono"><span class="tl-led tl-led-on" aria-hidden="true"></span>2024 — hoy</span>
        <div class="tl-body">
          <h3>Desarrollador web / Sysadmin</h3>
          <p>
            Desarrollo y mantenimiento de ERP/CRM (Dolibarr) y WordPress, administración de
            servidores, automatización mediante scripting, gestión de backups y soporte técnico a
            clientes.
          </p>
        </div>
      </li>

      <li class="tl-item">
        <span class="tl-date mono"><span class="tl-led" aria-hidden="true"></span>Formación</span>
        <div class="tl-body">
          <h3>Estudios técnicos</h3>
          <ul>
            <li>Perito Judicial en Informática y Electrónica Forense + Elaboración de Informes Periciales.</li>
            <li>Desarrollo de Aplicaciones Web (DAW).</li>
            <li>Administración de Sistemas Informáticos en Red (ASIR).</li>
          </ul>
        </div>
      </li>
    </ol>
  </section>

  <!-- =============================================================
       F3 — PROYECTOS
       ============================================================= -->
  <section id="proyectos" class="section container">
    <div class="section-head">
      <div>
        <h2 class="section-title"><span class="key key-mod">F3</span> Proyectos destacados</h2>
      </div>
      <a href={`${base}proyectos/`} class="see-all">Ver todos <Icon name="arrow-right" size={15} /></a>
    </div>

    {featuredProjects.length === 0 ? (
      <div class="empty">
        <span class="empty-prompt">C:\PROYECTOS&gt; dir<span class="cursor" aria-hidden="true"></span></span>
        <p>Próximamente: los primeros proyectos documentados.</p>
      </div>
    ) : (
      <div class="project-grid">
        {featuredProjects.map((proyecto) => <ProjectCard proyecto={proyecto} />)}
      </div>
    )}
  </section>

  <!-- =============================================================
       F4 — WRITE-UPS
       ============================================================= -->
  <section id="writeups" class="section container">
    <div class="section-head">
      <h2 class="section-title"><span class="key key-mod">F4</span> Últimos write-ups</h2>
      <a href={`${base}posts/`} class="see-all">Ver todos <Icon name="arrow-right" size={15} /></a>
    </div>

    {recentPosts.length === 0 ? (
      <div class="empty">
        <span class="empty-prompt">C:\WRITEUPS&gt; dir<span class="cursor" aria-hidden="true"></span></span>
        <p>Aún no hay write-ups publicados.</p>
      </div>
    ) : (
      <div class="card post-list">
        {recentPosts.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </section>

  <!-- =============================================================
       F5 — CERTIFICACIONES
       ============================================================= -->
  <section id="certificaciones" class="section container">
    <div class="section-head">
      <div>
        <h2 class="section-title"><span class="key key-mod">F5</span> Certificaciones</h2>
        <p class="section-intro">
          Acreditaciones en seguridad y análisis forense, y formación técnica de base en desarrollo
          e infraestructura.
        </p>
      </div>
    </div>

    {certificaciones.length === 0 ? (
      <div class="empty">
        <span class="empty-prompt">C:\CERTS&gt; dir<span class="cursor" aria-hidden="true"></span></span>
        <p>Las certificaciones aparecerán aquí en cuanto las obtenga.</p>
      </div>
    ) : (
      <ul class="cert-grid">
        {certificaciones.map((c) => (
          <li class="card cert">
            <span class="mono cert-year">{c.year}</span>
            <strong class="cert-title">
              {c.url ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.title}</a> : c.title}
            </strong>
            <span class="muted">{c.issuer}</span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <!-- =============================================================
       CONTACTO
       ============================================================= -->
  <section id="contacto" class="section container">
    <div class="card contact">
      <div>
        <h2>¿Hablamos?</h2>
        <p class="muted">
          Si te interesa contactar conmigo por trabajo, un proyecto o un reto que quieras comentar,
          escríbeme y te respondo lo antes posible.
        </p>
      </div>
      <a href="mailto:iker.reyesn8@gmail.com" class="enter-key" aria-label="Escríbeme por correo">
        <span class="enter-legend">Intro</span>
        <span class="enter-text">Escríbeme <span aria-hidden="true">↵</span></span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ----------------------------------------------------------------
     HERO
     ---------------------------------------------------------------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 3.5rem;
  }

  .hero h1 {
    margin-bottom: 1.1rem;
  }

  /* "analizo" subrayado con rotulador */
  .hero-accent {
    color: var(--accent);
    background: linear-gradient(transparent 68%, var(--accent-soft) 68%);
    padding: 0 0.05em;
  }

  .hero-tagline {
    font-size: 1.15rem;
    color: var(--fg-muted);
    max-width: 50ch;
    margin-bottom: 1.6rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1.8rem;
  }

  .hero-skills .key {
    font-size: 0.78rem;
  }

  /* MONITOR beige con la foto */
  .monitor {
    justify-self: center;
    width: min(100%, 360px);
    animation-delay: 0.1s;
  }

  .monitor-bezel {
    padding: 18px 18px 10px;
    background: linear-gradient(180deg, #ebe6d8 0%, #d6d0bf 100%);
    border: 1px solid #a8a08a;
    border-radius: 14px 14px 10px 10px;
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.7),
      inset 0 -3px 0 rgba(0, 0, 0, 0.08),
      0 18px 40px rgba(40, 30, 10, 0.25);
  }

  :global([data-theme='dark']) .monitor-bezel {
    background: linear-gradient(180deg, #4a4943 0%, #35342f 100%);
    border-color: #1d1c19;
    box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.1), 0 18px 40px rgba(0, 0, 0, 0.5);
  }

  .monitor-screen {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 18px / 14px;
    border: 6px solid #2a2a27;
    background: #111;
    box-shadow: inset 0 0 0 1px #000;
  }

  .monitor-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Scanlines + reflejo del cristal */
  .monitor-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(255, 255, 255, 0.14), transparent 55%),
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 3px);
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.55);
  }

  .pic-night {
    display: none;
  }

  :global([data-theme='dark']) .pic-night {
    display: block;
  }

  :global([data-theme='dark']) .pic-day {
    display: none;
  }

  .monitor-chin {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 4px 2px;
  }

  .monitor-label {
    font-size: 0.66rem;
    letter-spacing: 0.15em;
    color: #6b6553;
  }

  :global([data-theme='dark']) .monitor-label {
    color: #9a9484;
  }

  .monitor-power {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--led-on);
    box-shadow: 0 0 6px var(--led-on);
  }

  .monitor-stand {
    width: 46%;
    height: 16px;
    margin: 0 auto;
    background: linear-gradient(180deg, #c9c2ae, #b5ad97);
    border-radius: 0 0 8px 8px;
    border: 1px solid #a8a08a;
    border-top: none;
  }

  :global([data-theme='dark']) .monitor-stand {
    background: linear-gradient(180deg, #2f2e29, #24231f);
    border-color: #1d1c19;
  }

  /* ----------------------------------------------------------------
     SOBRE MÍ
     ---------------------------------------------------------------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .facts {
    padding: 1.3rem 1.4rem;
  }

  .facts dl {
    display: flex;
    flex-direction: column;
  }

  .facts dl > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.8rem;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--line);
    font-size: 0.93rem;
  }

  .facts dl > div:last-child {
    border-bottom: none;
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    padding-top: 0.12rem;
  }

  /* ----------------------------------------------------------------
     TIMELINE
     ---------------------------------------------------------------- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tl-item {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 1.8rem;
    padding: 1.4rem 0;
    border-bottom: 1px dashed var(--line);
  }

  .tl-item:first-child {
    padding-top: 0;
  }

  .tl-item:last-child {
    border-bottom: none;
  }

  .tl-date {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    align-self: start;
    padding-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .tl-led {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--led-off);
    flex-shrink: 0;
  }

  .tl-led-on {
    background: var(--led-on);
    box-shadow: 0 0 6px var(--led-on);
  }

  .tl-body h3 {
    margin-bottom: 0.2rem;
  }

  .tl-sub {
    display: block;
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin-bottom: 0.4rem;
  }

  .tl-body p,
  .tl-body ul {
    margin: 0.4rem 0 0;
    color: var(--fg-muted);
  }

  .tl-body ul {
    padding-left: 1.2rem;
  }

  .tl-body li + li {
    margin-top: 0.25rem;
  }

  /* ----------------------------------------------------------------
     LISTADOS
     ---------------------------------------------------------------- */
  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--accent);
  }

  .see-all:hover {
    text-decoration: underline;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.4rem;
  }

  .post-list {
    overflow: hidden;
  }

  .cert-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .cert {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.1rem 1.2rem;
  }

  .cert-year {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }

  .cert-title a {
    color: var(--fg);
  }

  .cert-title a:hover {
    color: var(--accent);
  }

  /* ----------------------------------------------------------------
     CONTACTO + tecla Intro
     ---------------------------------------------------------------- */
  #contacto {
    border-top: none;
    padding-top: 1rem;
  }

  .contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 2.2rem;
  }

  .contact h2 {
    margin-bottom: 0.4rem;
  }

  .contact p {
    margin: 0;
    max-width: 52ch;
  }

  /* Tecla Intro grande (gris de modificador, legenda arriba a la izquierda) */
  .enter-key {
    --depth: 6px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 11rem;
    height: 5.2rem;
    padding: 0.55rem 0.8rem 0.6rem;
    color: var(--key-mod-fg);
    background: linear-gradient(180deg, var(--key-mod-top), var(--key-mod-bottom));
    border: 1px solid var(--key-edge);
    border-radius: 7px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -3px 0 rgba(0, 0, 0, 0.08),
      0 var(--depth) 0 var(--key-mod-side),
      0 calc(var(--depth) + 1px) 0 var(--key-edge),
      0 calc(var(--depth) + 5px) 10px rgba(0, 0, 0, 0.22);
    margin-bottom: calc(var(--depth) + 1px);
    transition: transform 0.06s ease, box-shadow 0.06s ease;
  }

  .enter-key:hover {
    filter: brightness(1.05);
  }

  .enter-key:active {
    transform: translateY(5px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 1px 0 var(--key-mod-side), 0 2px 0 var(--key-edge);
  }

  .enter-legend {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .enter-text {
    align-self: flex-end;
    font-weight: 700;
    font-size: 1.05rem;
  }

  /* ----------------------------------------------------------------
     RESPONSIVE
     ---------------------------------------------------------------- */
  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-top: 2.5rem;
    }
    .monitor {
      order: -1;
      width: min(70%, 280px);
    }
    .about {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .tl-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .contact {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
    }
    .enter-key {
      width: 100%;
    }
  }
</style>
