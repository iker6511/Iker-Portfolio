---
// ============================================================================
// proyectos/[...slug].astro — FICHA DE PROYECTO
// ============================================================================
// Cabecera con título y descripción, una ficha lateral con año, tecnologías
// y enlaces, y el contenido del Markdown.
// ============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const base = import.meta.env.BASE_URL;

const { Content } = await render(proyecto);
---

<BaseLayout title={`${proyecto.data.title} — Proyectos — Iker`} description={proyecto.data.description}>
  <div class="container">
    <header class="page-head">
      <a href={`${base}proyectos/`} class="key back-link"><Icon name="arrow-left" size={14} /> Proyectos</a>
      <span class="eyebrow">Proyecto · {proyecto.data.year}</span>
      <h1>{proyecto.data.title}</h1>
      <p class="page-intro">{proyecto.data.description}</p>
    </header>

    <div class="layout">
      <article class="prose">
        <Content />
      </article>

      <aside class="card specs">
        <span class="eyebrow">Ficha técnica</span>
        <dl>
          <div>
            <dt>Año</dt>
            <dd>{proyecto.data.year}</dd>
          </div>
          {proyecto.data.stack.length > 0 && (
            <div>
              <dt>Tecnologías</dt>
              <dd>
                <ul class="chips">
                  {proyecto.data.stack.map((tech) => <li class="key key-sm">{tech}</li>)}
                </ul>
              </dd>
            </div>
          )}
        </dl>

        {(proyecto.data.repo || proyecto.data.demo) && (
          <div class="specs-links">
            {proyecto.data.repo && (
              <a href={proyecto.data.repo} target="_blank" rel="noopener noreferrer" class="btn">
                <Icon name="github" size={16} /> Código
              </a>
            )}
            {proyecto.data.demo && (
              <a href={proyecto.data.demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Demo <Icon name="external" size={14} />
              </a>
            )}
          </div>
        )}
      </aside>
    </div>
  </div>

  <Lightbox />
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 3rem;
    align-items: start;
  }

  .layout .prose {
    max-width: 72ch;
  }

  .specs {
    position: sticky;
    top: 90px;
    padding: 1.3rem;
  }

  .specs dl > div {
    padding: 0.6rem 0;
    border-bottom: 1px dashed var(--line);
  }

  .specs dl > div:last-child {
    border-bottom: none;
  }

  .specs dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    margin-bottom: 0.35rem;
  }

  .specs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .specs {
      position: static;
      order: -1;
    }
  }
</style>
