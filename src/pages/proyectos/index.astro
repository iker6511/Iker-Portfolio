---
// ============================================================================
// proyectos/index.astro — LISTADO DE PROYECTOS
// ============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('proyectos');
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.order !== b.data.order) return b.data.order - a.data.order;
  return b.data.year - a.data.year;
});

const count = `${sortedProjects.length} ${sortedProjects.length === 1 ? 'proyecto' : 'proyectos'}`;
---

<BaseLayout
  title="Proyectos — Iker"
  description="Proyectos personales de análisis forense, desarrollo y administración de sistemas, documentados con sus objetivos, herramientas y resultados."
>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">Proyectos personales · {count}</span>
      <h1>Proyectos</h1>
      <p class="page-intro">
        Aquí encontrarás proyectos de análisis forense y tecnología en los que trabajo. Cada ficha
        resume su objetivo, el proceso y los resultados, junto con las herramientas utilizadas.
      </p>
    </header>

    {sortedProjects.length === 0 ? (
      <div class="empty">
        <span class="empty-prompt">C:\PROYECTOS&gt; dir<span class="cursor" aria-hidden="true"></span></span>
        <p>Todavía no hay proyectos publicados.</p>
      </div>
    ) : (
      <div class="project-grid">
        {sortedProjects.map((proyecto) => <ProjectCard proyecto={proyecto} />)}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.4rem;
  }
</style>
