---
// ============================================================================
// Footer.astro — pie de página
// ============================================================================
// Contacto, atajos de teclado y la "placa" del teclado con el que se escribe
// todo esto.
//
// PARA EDITAR LOS ENLACES: cambia el array `socials`.
// ============================================================================

import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

// 👇 EDITA AQUÍ tus enlaces 👇
const socials: { name: string; url: string; icon: IconName }[] = [
  { name: 'GitHub', url: 'https://github.com/iker6511', icon: 'github' },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/ikerreyesnavarro/', icon: 'linkedin' },
  { name: 'Correo', url: 'mailto:iker.reyesn8@gmail.com', icon: 'mail' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">

    <div class="footer-col">
      <span class="eyebrow">Contacto</span>
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a
              href={s.url}
              target={s.url.startsWith('http') ? '_blank' : undefined}
              rel="noopener noreferrer"
            >
              <Icon name={s.icon} size={16} />
              {s.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <span class="eyebrow">Atajos de teclado</span>
      <ul class="shortcuts">
        <li><kbd>I</kbd> Inicio</li>
        <li><kbd>P</kbd> Proyectos</li>
        <li><kbd>N</kbd> Notas</li>
        <li><kbd>T</kbd> Tema claro/oscuro</li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} Iker Reyes</span>
    <span class="mono">Hecho con Astro + CSS · sin cookies</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 3rem 0 1.5rem;
    background: var(--bg-alt);
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2.5rem;
  }

  /* Placa estilo "etiqueta del teclado" */
  .footer-plate {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .footer-plate p {
    margin: 0;
    color: var(--fg-muted);
    max-width: 38ch;
  }

  .footer-plate strong {
    color: var(--fg);
  }

  .plate-badge {
    flex-shrink: 0;
    padding: 0.35rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #e9e5da;
    background: linear-gradient(180deg, #4a4a46, #2c2c29);
    border: 1px solid #1b1b19;
    border-radius: 3px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .socials,
  .shortcuts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    text-decoration: none;
  }

  .socials a:hover {
    color: var(--accent);
  }

  .shortcuts li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg-muted);
  }

  .shortcuts kbd {
    min-width: 1.7rem;
    text-align: center;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px dashed var(--line-strong);
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-plate {
      grid-column: 1 / -1;
    }
  }

  /* En pantallas táctiles los atajos no aportan nada */
  @media (hover: none) {
    .footer-col:last-child {
      display: none;
    }
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
