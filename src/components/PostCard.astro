---
// ============================================================================
// PostCard.astro — fila de write-up en un listado
// ============================================================================
// Fecha en mono a la izquierda (AAAA-MM-DD, como un log), título, resumen y
// etiquetas. Toda la fila es un enlace.
// ============================================================================

import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const isoDate = post.data.pubDate.toISOString().slice(0, 10);
---

<a href={`${base}posts/${post.id}/`} class="post-row">
  <time class="post-date mono" datetime={post.data.pubDate.toISOString()}>{isoDate}</time>

  <span class="post-main">
    <span class="post-title">{post.data.title}</span>
    <span class="post-desc">{post.data.description}</span>
    {post.data.tags.length > 0 && (
      <span class="post-tags mono">{post.data.tags.map((t) => `#${t}`).join('  ')}</span>
    )}
  </span>

  <span class="post-arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
</a>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    gap: 1.2rem;
    align-items: start;
    padding: 1.2rem 1.3rem;
    color: var(--fg);
    border-bottom: 1px dashed var(--line);
    transition: background 0.12s ease;
  }

  .post-row:last-child {
    border-bottom: none;
  }

  .post-row:hover {
    background: var(--surface-2);
  }

  .post-date {
    padding-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .post-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .post-title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .post-row:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .post-tags {
    font-size: 0.76rem;
    color: var(--accent);
  }

  .post-arrow {
    padding-top: 0.25rem;
    color: var(--fg-muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .post-row:hover .post-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 600px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
      padding: 1rem;
    }
    .post-arrow {
      display: none;
    }
  }
</style>
