---
// ============================================================================
// ProjectCard.astro — tarjeta de proyecto
// ============================================================================
// Año, título, descripción, tecnologías (como mini teclas) y enlaces.
// El título enlaza a la ficha completa del proyecto.
// ============================================================================

import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}proyectos/${proyecto.id}/`;
---

<article class="card project">
  <span class="project-meta mono">{proyecto.data.year} · proyecto</span>

  <h3 class="project-title">
    <a href={href}>{proyecto.data.title}</a>
  </h3>

  <p class="project-desc">{proyecto.data.description}</p>

  {proyecto.data.stack.length > 0 && (
    <ul class="chips">
      {proyecto.data.stack.map((tech) => <li class="key key-sm">{tech}</li>)}
    </ul>
  )}

  <div class="project-links">
    <a href={href} class="project-more">
      Ver proyecto <Icon name="arrow-right" size={15} />
    </a>
    {proyecto.data.repo && (
      <a href={proyecto.data.repo} target="_blank" rel="noopener noreferrer">
        Código <Icon name="external" size={13} />
      </a>
    )}
    {proyecto.data.demo && (
      <a href={proyecto.data.demo} target="_blank" rel="noopener noreferrer">
        Demo <Icon name="external" size={13} />
      </a>
    )}
  </div>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    height: 100%;
    padding: 1.4rem 1.4rem 1.2rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .project:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
  }

  /* Tira de color superior, como la etiqueta de un disquete */
  .project::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 1.4rem;
    width: 3.2rem;
    height: 5px;
    border-radius: 0 0 3px 3px;
    background: var(--accent);
  }

  .project-meta {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .project-title {
    font-size: 1.2rem;
  }

  .project-title a:hover {
    color: var(--accent);
  }

  /* Toda la tarjeta clicable sin romper los demás enlaces */
  .project-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .project-desc {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .chips {
    margin-top: 0.2rem;
  }

  .project-links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--fg-muted);
  }

  .project-links a:hover,
  .project-links .project-more {
    color: var(--accent);
  }
</style>
